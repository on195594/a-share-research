TUSHARE_TOKEN=
# pi runtime (model access); see ~/.pi/agent
# Empty: follow the managed install in PI_AGENT_DIR/install/current-version
PI_RUNTIME=
PI_AGENT_DIR=
PI_EXTENSION=
MODEL_PROVIDER=
MODEL_ID=
# 模型思考强度：high (默认) | medium | low | off
MODEL_REASONING=high
# 输出 token 上限（默认 16000，以容纳思考 token）
MODEL_MAX_TOKENS=16000
# Optional: PI_DAEMON=1 (default: persistent Node daemon over Unix socket; 0 to force one-shot CLI mode)
PI_DAEMON=

